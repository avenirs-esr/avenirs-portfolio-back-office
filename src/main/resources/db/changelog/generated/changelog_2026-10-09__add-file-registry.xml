<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="iamgreendev" id="file-registry-create-table">
        <createTable tableName="file">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="filePK"/>
            </column>
            <column name="file_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="file_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="size" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="uri" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="is_restricted" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="file"/>
        </rollback>
    </changeSet>

    <changeSet author="iamgreendev" id="file-registry-add-uploaded-by-index">
        <createIndex tableName="file" indexName="idx_file_uploaded_by">
            <column name="uploaded_by"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="file" indexName="idx_file_uploaded_by"/>
        </rollback>
    </changeSet>

    <changeSet author="iamgreendev" id="file-registry-link-cgu-to-file">
        <addForeignKeyConstraint
                baseTableName="cgu"
                baseColumnNames="file_id"
                constraintName="FK_cgu_file"
                referencedTableName="file"
                referencedColumnNames="id"
                validate="false"/>

        <rollback>
            <dropForeignKeyConstraint baseTableName="cgu" constraintName="FK_cgu_file"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
